<?xml version="1.0" encoding="utf-8"?>
<!-- Deny cleartext and block all network by default; app is offline-first. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
